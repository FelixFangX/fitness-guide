---
import { withBase } from '../lib/paths';

type Props = {
  showBrand?: boolean;
};

const { showBrand = true } = Astro.props;
---

<header class="site-header">
  <div class:list={["nav-shell", "page-shell", { "nav-shell-end": !showBrand }]}>
    {showBrand && <a class="brand" href={withBase()} aria-label="Workout Guide home">
      <span class="brand-mark" data-squircle data-radius="11" aria-hidden="true">WG</span>
      <span>Workout Guide</span>
    </a>}
    <nav aria-label="Primary navigation">
      <a href={withBase('exercises/')}>Exercises</a>
      <a href={withBase('guide/')}>Guide</a>
      <a href="https://github.com/bryllim/workout-guide">GitHub</a>
    </nav>
  </div>
</header>
