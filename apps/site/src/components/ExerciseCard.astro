---
import type { Exercise } from '@bryllim/workout-guide';
import MotionIllustration from './MotionIllustration.astro';
import { getLocalizedExercise } from '../lib/i18n';
import type { SiteLocale } from '../lib/locale';
import { withLocale } from '../lib/paths';

type Props = {
  exercise: Exercise;
  locale: SiteLocale;
};

const { exercise, locale } = Astro.props;
const localized = getLocalizedExercise(exercise, locale);
const searchText = [
  exercise.name,
  exercise.equipment,
  exercise.primaryMuscle,
  ...exercise.secondaryMuscles,
  localized.name,
  localized.equipment,
  localized.primaryMuscle,
  ...localized.secondaryMuscles,
  ...localized.aliases,
].join(' ').toLowerCase();
const illustrationAlt = locale === 'zh-CN'
  ? `${localized.name}动作插画`
  : `${localized.name} exercise illustration`;
---

<article
  class="exercise-card"
  data-exercise-card
  data-search={searchText}
  data-equipment={exercise.equipment}
  data-muscle={exercise.primaryMuscle}
  data-type={exercise.exerciseType}
>
  <a class="movement-card focus-shell" href={withLocale(locale, `exercises/${exercise.slug}/`)}>
    <div class="movement-card-image">
      <MotionIllustration slug={exercise.slug} alt={illustrationAlt} />
    </div>
    <div class="movement-card-copy"><span>{localized.primaryMuscle}</span><h2>{localized.name}</h2><p>{localized.equipment}</p></div>
  </a>
</article>
