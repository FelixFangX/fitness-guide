---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MotionIllustration from '../MotionIllustration.astro';
import type { SiteLocale } from '../../lib/locale';
import { withLocale } from '../../lib/paths';
import { getPlannedExercises, getSessionText, trainingSessions } from '../../lib/training';

type Props = {
  locale: SiteLocale;
};

const { locale } = Astro.props;
const copy = locale === 'zh-CN'
  ? { title: '健身指南 — 今天的训练', description: '个人使用的本地优先健身训练指南。', eyebrow: '你的训练节奏', heading: '今天，只完成下一组。', summary: '三套全身训练计划，动作提示、完成记录和 SVG 动作示意都在这里。记录仅保存在此设备。', start: '开始今天的训练', plan: '查看训练计划', today: '今天推荐', duration: '预计时长', movements: '个动作', weekly: '本周已完成', sessions: '次训练', planTitle: '本周的三套训练。', planSummary: '无需照日历补课；选择最适合今天状态的一节开始。', viewPlan: '打开完整计划', library: '动作库', libraryTitle: '每个动作都有清晰示意。', librarySummary: '需要替换动作时，再进入动作库按肌群和器械查找。', openLibrary: '浏览动作库' }
  : { title: 'Fitness Guide — Today’s workout', description: 'A local-first fitness guide for personal use.', eyebrow: 'Your training rhythm', heading: 'Today, complete the next set.', summary: 'Three full-body sessions with movement cues, completion tracking, and SVG movement guides. Records stay on this device.', start: 'Start today’s workout', plan: 'View training plan', today: 'Recommended today', duration: 'Estimated time', movements: 'movements', weekly: 'Completed this week', sessions: 'sessions', planTitle: 'Three sessions for the week.', planSummary: 'No calendar catch-up required. Start with the session that suits your energy today.', viewPlan: 'Open full plan', library: 'Movement library', libraryTitle: 'Every movement has a clear visual guide.', librarySummary: 'Use the library to find a replacement by muscle group or equipment when you need one.', openLibrary: 'Browse movements' };
const today = trainingSessions[0];
const todayText = getSessionText(today, locale);
const sessions = trainingSessions.map((session) => ({ session, text: getSessionText(session, locale), exercises: getPlannedExercises(session) }));
---

<BaseLayout title={copy.title} description={copy.description} {locale} path="">
  <section class="app-shell home-page page-shell" aria-labelledby="hero-title">
    <div class="home-hero">
      <div class="home-copy"><p class="eyebrow">{copy.eyebrow}</p><h1 id="hero-title">{copy.heading}</h1><p>{copy.summary}</p><div class="hero-actions"><a class="primary-button" href={withLocale(locale, 'workout/')}>{copy.start}</a><a class="quiet-link" href={withLocale(locale, 'plan/')}>{copy.plan} <span aria-hidden="true">→</span></a></div></div>
      <aside class="today-card" data-squircle data-radius="44"><div class="today-card-top"><span>{copy.today}</span><span class="pulse-dot" aria-hidden="true"></span></div><MotionIllustration slug={today.exercises[1].slug} alt="" class="today-card-motion" loading="eager" /><div><p>{todayText.focus}</p><h2>{todayText.title}</h2><div class="today-meta"><span>{todayText.duration}</span><span>{today.exercises.length} {copy.movements}</span></div></div></aside>
    </div>
    <div class="weekly-strip" data-squircle data-radius="28"><p>{copy.weekly}</p><strong><b data-weekly-complete>0</b> / 3 {copy.sessions}</strong><a href={withLocale(locale, 'progress/')}>{locale === 'zh-CN' ? '查看进度' : 'View progress'} <span aria-hidden="true">→</span></a></div>
  </section>
  <section class="app-shell plan-preview page-shell" aria-labelledby="plan-preview-title"><div class="section-intro"><div><p class="eyebrow">{copy.plan}</p><h2 id="plan-preview-title">{copy.planTitle}</h2></div><p>{copy.planSummary}</p></div><div class="home-session-grid">{sessions.map(({ session, text, exercises }) => <article class="home-session-card" data-squircle data-radius="32"><div class="session-card-head"><span>{session.number}</span><span>{text.duration}</span></div><h3>{text.title}</h3><p>{text.focus}</p><div class="session-card-images">{exercises.slice(0, 3).map(({ exercise }) => <MotionIllustration slug={exercise.slug} alt="" />)}</div><a class="card-action" data-select-session={session.id} href={withLocale(locale, 'workout/')}>{locale === 'zh-CN' ? '开始这节训练' : 'Start this session'} <span aria-hidden="true">→</span></a></article>)}</div><a class="text-link" href={withLocale(locale, 'plan/')}>{copy.viewPlan} <span aria-hidden="true">→</span></a></section>
  <section class="app-shell library-callout page-shell" data-squircle data-radius="40"><div><p class="eyebrow">{copy.library}</p><h2>{copy.libraryTitle}</h2><p>{copy.librarySummary}</p><a class="secondary-button" href={withLocale(locale, 'exercises/')}>{copy.openLibrary}</a></div><MotionIllustration slug="cat-cow-stretch" alt="" class="library-callout-motion" /></section>
</BaseLayout>
