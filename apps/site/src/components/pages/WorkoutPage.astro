---
import { getLocalizedExercise } from '../../lib/i18n';
import MotionIllustration from '../MotionIllustration.astro';
import type { SiteLocale } from '../../lib/locale';
import { withLocale } from '../../lib/paths';
import { getPlannedExercises, getSessionText, trainingSessions } from '../../lib/training';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const copy = locale === 'zh-CN'
  ? { title: '今日训练 — 健身指南', description: '完成今天的个人训练计划。', eyebrow: '今天的训练', heading: '把注意力放在下一组。', back: '查看本周计划', total: '预计时长', set: '组', rest: '组间恢复', cue: '动作提示', source: '查看动作详情', note: '按自己的状态调整次数；疼痛、眩晕或呼吸不适时请立即停止。', complete: '完成这一组' }
  : { title: 'Today’s workout — Fitness Guide', description: 'Complete your personal workout for today.', eyebrow: 'Today’s workout', heading: 'Keep your attention on the next set.', back: 'View weekly plan', total: 'Estimated time', set: 'sets', rest: 'Between-set recovery', cue: 'Movement cue', source: 'View movement details', note: 'Adjust repetitions for your current ability. Stop immediately for pain, dizziness, or breathing discomfort.', complete: 'Complete this set' };
---

<BaseLayout title={copy.title} description={copy.description} {locale} path="workout/">
  <section class="app-shell workout-page page-shell" aria-labelledby="workout-title">
    <header class="workout-intro">
      <div><p class="eyebrow">{copy.eyebrow}</p><h1 id="workout-title">{copy.heading}</h1></div>
      <a class="text-link" href={withLocale(locale, 'plan/')}>{copy.back} <span aria-hidden="true">→</span></a>
    </header>

    {trainingSessions.map((session, sessionIndex) => {
      const sessionText = getSessionText(session, locale);
      const plannedExercises = getPlannedExercises(session);
      return <section class="workout-session" data-workout-session data-session-id={session.id} hidden={sessionIndex !== 0}>
        <div class="workout-session-head">
          <div><p class="session-index">{session.number}</p><h2>{sessionText.title}</h2><p>{sessionText.focus}</p></div>
          <div class="session-status" data-session-status={session.id}>{locale === 'zh-CN' ? '进行中' : 'In progress'}</div>
        </div>
        <div class="workout-exercise-list">
          {plannedExercises.map(({ exercise, sets, target, rest, cue }, index) => {
            const localized = getLocalizedExercise(exercise, locale);
            return <article class="workout-exercise" data-workout-exercise>
              <div class="workout-order" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
              <div class="workout-visual"><MotionIllustration slug={exercise.slug} alt={`${localized.name}${locale === 'zh-CN' ? '动作示意' : ' exercise illustration'}`} loading="eager" /></div>
              <div class="workout-copy">
                <div class="exercise-heading"><div><p class="eyebrow">{localized.primaryMuscle}</p><h3>{localized.name}</h3></div><span class="set-progress" data-set-progress>0/{sets}</span></div>
                <div class="prescription"><strong>{sets} {copy.set} × {target[locale]}</strong><span>{rest[locale]}</span></div>
                <p class="movement-cue"><span>{copy.cue}</span>{cue[locale]}</p>
                <div class="exercise-actions"><button class="primary-button" type="button" data-complete-set data-session-id={session.id} data-exercise-id={exercise.id} data-total-sets={sets}>{copy.complete} · 0/{sets}</button><a class="quiet-link" href={withLocale(locale, `exercises/${exercise.slug}/`)}>{copy.source}</a></div>
              </div>
            </article>;
          })}
        </div>
        <aside class="training-note"><span aria-hidden="true">✦</span><p>{copy.note}</p></aside>
      </section>;
    })}
  </section>
</BaseLayout>
